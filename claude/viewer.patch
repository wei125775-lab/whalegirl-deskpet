+// ---------- 外部状态（Claude Code 在不在干活）----------
+// hook 脚本往这个文件写 {"state":"working"|"idle"}。用下面已有的每秒 tick 轮询 mtime，
+// 而不是 fs.watch——Windows 上盯单个文件时，写入方一 rename 覆盖句柄就失效，watcher
+// 会静默死亡且不报错。复用 tick 还天然带 1 秒 debounce，避免一次写入触发多次。
+const STATE_FILE = path.join(app.getPath('home'), '.petpet', 'state.json')
+const STATE_STALE_MS = 30 * 60 * 1000   // 太久没更新说明 Claude 那边断了，别让桌宠一直吃
+// 外部状态信号的白名单：hook 写什么就往渲染层透传什么。
+// 原先只认 'working'、其余一律当 idle——于是 'interrupted'（用户按 Esc 打断，
+// 由 interrupt-watch.mjs 写出）被吞掉，她打完断还在端着碗吃。认不出来的值仍按 idle。
+const EXTERNAL_STATES = new Set(['working', 'interrupted'])
+let lastStateMtime = 0
+let lastStateSent = ''
+
+function pollExternalState() {
+  let st
+  try {
+    st = fs.statSync(STATE_FILE)
+  } catch (e) {
+    return // hook 还没写过，正常
+  }
+  let state
+  if (st.mtimeMs !== lastStateMtime) {
+    lastStateMtime = st.mtimeMs
+    state = 'idle'
+    try {
+      const obj = JSON.parse(fs.readFileSync(STATE_FILE, 'utf-8'))
+      if (obj && typeof obj.state === 'string' && EXTERNAL_STATES.has(obj.state)) state = obj.state
+    } catch (e) { /* 写了一半的撕裂读，按 idle */ }
+  } else {
+    state = lastStateSent || 'idle'
+  }
+  if (Date.now() - st.mtimeMs > STATE_STALE_MS) state = 'idle'
+  if (state !== lastStateSent) {
+    lastStateSent = state
+    console.log('[PetPet] 外部状态 → ' + state)
+    send('pet:state', state)
+  }
+}
+
