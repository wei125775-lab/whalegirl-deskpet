{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/petpet-launch.mjs\""
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/petpet-state.mjs\" working"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/petpet-state.mjs\" idle"
        }
      ]
    }
  ],
  "SubagentStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/petpet-subagent.mjs\""
        }
      ]
    }
  ],
  "SubagentStop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/petpet-subagent.mjs\""
        }
      ]
    }
  ]
}
